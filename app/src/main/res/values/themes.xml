<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.JLU.Navigation" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.JLU.Navigation.Active" parent="TextAppearance.JLU.Navigation">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.JLU" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.JLU.Warm">
        <item name="android:textColorPrimary">@color/warm_text_primary</item>
        <item name="android:textColorSecondary">@color/warm_text_secondary</item>
        <item name="android:textColorHint">@color/warm_text_secondary</item>
        <item name="colorPrimary">@color/warm_icon_tint</item>
        <item name="colorAccent">@color/warm_icon_tint</item>
        <item name="colorControlNormal">@color/warm_icon_tint</item>
        <item name="colorControlActivated">@color/warm_icon_tint</item>
        <item name="android:windowBackground">@color/warm_page_background</item>
    </style>

    <style name="Theme.JLU.Ocean">
        <item name="android:textColorPrimary">@color/ocean_text_primary</item>
        <item name="android:textColorSecondary">@color/ocean_text_secondary</item>
        <item name="android:textColorHint">@color/ocean_text_secondary</item>
        <item name="colorPrimary">@color/ocean_icon_tint</item>
        <item name="colorAccent">@color/ocean_icon_tint</item>
        <item name="colorControlNormal">@color/ocean_icon_tint</item>
        <item name="colorControlActivated">@color/ocean_icon_tint</item>
        <item name="android:windowBackground">@color/ocean_page_background</item>
    </style>

    <style name="Theme.JLU.Mint">
        <item name="android:textColorPrimary">@color/mint_text_primary</item>
        <item name="android:textColorSecondary">@color/mint_text_secondary</item>
        <item name="android:textColorHint">@color/mint_text_secondary</item>
        <item name="colorPrimary">@color/mint_icon_tint</item>
        <item name="colorAccent">@color/mint_icon_tint</item>
        <item name="colorControlNormal">@color/mint_icon_tint</item>
        <item name="colorControlActivated">@color/mint_icon_tint</item>
        <item name="android:windowBackground">@color/mint_page_background</item>
    </style>

    <!-- 设置页卡片分组样式（颜色在代码中按主题色板动态着色） -->
    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="SettingsCardHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsCardIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SettingsCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="SettingsFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <style name="SettingsRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="SettingsRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <style name="SettingsRowChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:src">@drawable/ic_settings_chevron</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:alpha">0.55</item>
        <item name="android:tint">?android:attr/textColorSecondary</item>
    </style>

    <style name="SettingsRowSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="SettingsSegment">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">3dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsSegmentButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">?android:attr/textColorSecondary</item>
        <item name="android:alpha">0.16</item>
    </style>

    <style name="SettingsCardHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
<!-- 课程详情底部弹窗样式（颜色在代码中按主题色板动态着色） -->
    <style name="CourseDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="CourseDetailDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">40dp</item>
        <item name="android:alpha">0.5</item>
    </style>

    <style name="CourseDetailIconChip">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
    </style>

    <style name="CourseDetailIcon">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="CourseDetailLabel">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CourseDetailValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="SettingsSecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
